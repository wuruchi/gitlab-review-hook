GITLAB_WEBHOOK_SECRET=replace-with-your-gitlab-webhook-secret
GITLAB_TOKEN=replace-with-your-gitlab-token
GITLAB_BASE_URL=https://gitlab.com/api/v4 # Optional, override for self-hosted GitLab
GEMINI_API_KEY=replace-with-your-gemini-api-key # Optional, only needed if using Gemini as the LLM provider
AWS_BEARER_TOKEN_BEDROCK=replace-with-your-bedrock-api-key
AWS_REGION=eu-west-1